{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?!(Read|Glob|Grep|LS|TodoWrite|TodoRead|AskUserQuestion|ToolSearch|ExitPlanMode|EnterPlanMode)$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ],
            "timeout": 360,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(Read|Glob|Grep)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!(Read|Glob|Grep|LS|TodoWrite|TodoRead|AskUserQuestion|ToolSearch|ExitPlanMode|EnterPlanMode)$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!(Read|Glob|Grep|LS|TodoWrite|TodoRead|AskUserQuestion|ToolSearch|ExitPlanMode|EnterPlanMode)$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/nodrail-hook.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
